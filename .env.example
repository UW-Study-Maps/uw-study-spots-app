# Transit public API key (https://transitapp.com/apis) — live bus departures and
# route shapes. Copy this file to .env.local and fill in a real key;
# .env.local is gitignored.
#
# EXPO_PUBLIC_ vars are inlined into the JS bundle in plain text, so this key is
# visible to anyone with the app. Transit issues `transit_publicapi_*` keys for
# exactly that use, but rotate it from the Transit dashboard if abused.
EXPO_PUBLIC_TRANSIT_API_KEY=

# Valhalla routing server for walking and cycling paths. Defaults to the
# OpenStreetMap community demo server, which is fine for development but has a
# fair-use policy and no uptime guarantee — point this at your own instance or a
# paid provider before shipping. If it is unreachable the app falls back to
# straight lines and says so on the routes screen.
EXPO_PUBLIC_VALHALLA_URL=

# Google Maps key for the basemap (react-native-maps with PROVIDER_GOOGLE).
# Enable "Maps SDK for Android" and "Maps SDK for iOS" on the key in Google
# Cloud Console, then restrict it to this app's bundle id / package name.
#
# Deliberately NOT prefixed EXPO_PUBLIC_: it is read by app.config.js and
# written into the native Info.plist / AndroidManifest, so it never enters the
# JS bundle. Without it the map tiles render blank.
GOOGLE_MAPS_API_KEY=
